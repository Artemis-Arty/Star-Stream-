# ============================================================
# Star Stream: The Constellations - environment configuration
# Copy this file to .env and fill in the values.
# NEVER commit .env - it is gitignored.
# ============================================================

# ---------- Runtime ----------
# development | production | test
NODE_ENV=development

# ---------- Discord ----------
# Bot token from the Discord Developer Portal (Bot section)
DISCORD_TOKEN=
# Application (client) ID from the Developer Portal
CLIENT_ID=
# Guild (server) ID where the bot will run. Use a TEST guild first.
GUILD_ID=

# ---------- Database ----------
# External PostgreSQL connection URL. Do NOT rely on host-local files.
# On Bot-Hosting.net, provision a PostgreSQL database (host-provided or
# external like Neon/Supabase) and paste its URL here.
# Use ?sslmode=require when the provider requires SSL.
DATABASE_URL=postgresql://user:password@host:5432/starstream

# Run pending migrations automatically on bot startup (true/false)
AUTO_MIGRATE=true

# ---------- Timezone ----------
# IANA timezone used to decide "the current day" (Arena Days:
# Monday, Wednesday, Saturday) and day boundaries.
# Examples: UTC, Europe/London, Asia/Kolkata, America/New_York
TIMEZONE=UTC

# Hour of day (0-23, in TIMEZONE) when an unfilled vacant throne re-opens
# its Role Collection on an Arena Day (Mon/Wed/Sat). Default: 0 (midnight).
COLLECTION_OPEN_HOUR=0

# ---------- Channels ----------
# IDs of the three game channels + the staff audit log channel.
# These can be overridden at runtime with /starstream-config.
CHANNEL_RULES_ID=
CHANNEL_ALERTS_ID=
CHANNEL_CHALLENGE_ID=
CHANNEL_LOG_ID=

# ---------- Backups ----------
# Directory where automatic/logical backups are written.
BACKUP_DIR=./backups
# Hours between automatic backups (0 disables automatic backups)
BACKUP_INTERVAL_HOURS=24
# How many automatic backups to keep
BACKUP_RETENTION=14
